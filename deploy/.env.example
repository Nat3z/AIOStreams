# Read by deploy/compose.yaml.

# Where compose publishes AIOStreams: this machine's Tailscale address.
TAILSCALE_IP=100.87.64.61

# -- AIOStreams --
BASE_URL=https://aio.natfor.work
# openssl rand -hex 32
SECRET_KEY=
# Caddy on oci-selfhosted, so rate limits see each person's own address.
TRUSTED_IPS=100.85.134.9
# The configure page is the owner's alone.
AIOSTREAMS_AUTH_REQUIRED=true
# The owner's dashboard sign-in, user:password.
AIOSTREAMS_AUTH=shar:
# openssl rand -hex 32
CONFIG_ACCESS_KEY=
# Filled in after the owner's configuration is first saved: alias:uuid:encryptedPassword.
ALIASED_CONFIGURATIONS=
JELLYFIN_INSTANCE_ALIAS=home

# -- Metadata --
# Recommendations, "because you watched" rows and artwork. A free key from
# themoviedb.org → Settings → API.
TMDB_API_KEY=
